# Production image: build the static site, then serve it (and proxy the API) with Caddy.
FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
# empty = same origin as the page
ENV VITE_API_URL="" VITE_WS_URL=""
RUN npm run build

FROM caddy:2.8-alpine
COPY --from=build /app/dist /srv
