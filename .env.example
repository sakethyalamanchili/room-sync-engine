# Backend
DATABASE_URL=postgresql+asyncpg://roomsync:roomsync@postgres:5432/roomsync
REDIS_URL=redis://redis:6379/0
BUSINESS_TZ=America/New_York
BUSINESS_DAY_START=08:00
BUSINESS_DAY_END=18:00
SLOT_MINUTES=30
MAX_BOOKING_MINUTES=240
PAST_TOLERANCE_MINUTES=10
GHOST_GRACE_MINUTES=15
GHOST_INTERVAL_SECONDS=60
CACHE_TTL_SECONDS=300
LOCK_TTL_SECONDS=3
IDEMPOTENCY_TTL_SECONDS=86400
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10
CORS_ORIGINS=http://localhost:5173
ENABLE_BACKGROUND_TASKS=true

# Host port for Postgres (change if 5432 is taken on your machine)
POSTGRES_HOST_PORT=5432

# Tests (used by backend/tests/conftest.py)
TEST_DATABASE_URL=postgresql+asyncpg://roomsync:roomsync@localhost:5432/roomsync_test
TEST_REDIS_URL=redis://localhost:6379/15

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/api/v1/ws
