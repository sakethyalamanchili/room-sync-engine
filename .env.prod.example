# Copy to .env on the server and fill in. Never commit the real one.

# your domain, e.g. eecs-roomsync.duckdns.org (must already point at the server)
DOMAIN=

# letters and numbers only (it goes into a URL). openssl rand -hex 16
POSTGRES_PASSWORD=

# grafana login for user "admin" (visitors get read-only access without logging in)
GRAFANA_ADMIN_PASSWORD=

# shared password for the whole site
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'your-password'
# keep the single quotes, the hash contains $ signs
BASIC_AUTH_USER=eecs
BASIC_AUTH_HASH=''
